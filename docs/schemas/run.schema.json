          "title": "Harness Sha256",
          "type": "string"
        },
        "patch_sha256": {
          "title": "Patch Sha256",
          "type": "string"
        },
        "patched_tree_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Patched Tree Sha256"
        },
        "poc_tree_sha256": {
          "title": "Poc Tree Sha256",
          "type": "string"
        }
      },
      "required": [
        "base_tree_sha256",
        "poc_tree_sha256",
        "patch_sha256",
        "patched_tree_sha256",
        "harness_sha256"
