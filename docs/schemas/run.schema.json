{
  "$defs": {
    "Bounds": {
      "additionalProperties": false,
      "description": "What ran, as numbers. Deterministic: the same inputs give the same bounds.",
      "properties": {
        "exploit_replays_per_revision": {
          "title": "Exploit Replays Per Revision",
          "type": "integer"
        },
        "fuzz_runs": {
          "title": "Fuzz Runs",
          "type": "integer"
        },
        "fuzz_seed": {
          "title": "Fuzz Seed",
          "type": "string"
        },
        "interface_contracts": {
          "items": {
            "type": "string"
          },
          "title": "Interface Contracts",
          "type": "array"
        },
        "oracles_not_run": {
          "items": {
            "$ref": "#/$defs/OracleName"
          },
          "title": "Oracles Not Run",
          "type": "array"
        },
        "oracles_run": {
          "items": {
            "$ref": "#/$defs/OracleName"
          },
          "title": "Oracles Run",
          "type": "array"
        },
        "profile": {
          "enum": [
            "quick",
            "standard",
            "thorough"
          ],
          "title": "Profile",
          "type": "string"
        },
        "symbolic": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolicBounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/VariantBounds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "exploit_replays_per_revision",
        "profile",
        "fuzz_seed",
        "fuzz_runs",
        "interface_contracts",
        "oracles_run",
        "oracles_not_run",
        "variant"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "CampaignTime": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fuzz",
            "invariant",
            "confirmation"
          ],
          "title": "Mode",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/RevisionKind"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "seed_index": {
          "title": "Seed Index",
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "mode",
        "seed_index",
        "seconds"
      ],
      "title": "CampaignTime",
      "type": "object"
    },
    "CheckBounds": {
      "additionalProperties": false,
      "description": "What Halmos reported for one property on one revision. Deterministic.",
      "properties": {
        "bounded_loops": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bounded Loops"
        },
        "calldata_bytes": {
          "title": "Calldata Bytes",
          "type": "integer"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "halmos_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Halmos Code"
        },
        "kind": {
          "enum": [
            "variant",
            "equivalence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "no_counterexample",
            "counterexample",
            "unknown",
            "not_reported"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "paths": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Paths"
        },
        "revision": {
          "$ref": "#/$defs/RevisionKind"
        },
        "signature": {
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "contract",
        "signature",
        "kind",
        "outcome",
        "halmos_code",
        "calldata_bytes",
        "paths",
        "bounded_loops"
      ],
      "title": "CheckBounds",
      "type": "object"
    },
    "FinalVerdict": {
      "description": "Final verdict of a verification (table `verification`).",
      "enum": [
        "VERIFIED_WITHIN_BOUNDS",
        "REJECTED",
        "INCONCLUSIVE"
      ],
      "title": "FinalVerdict",
      "type": "string"
    },
    "FixHistory": {
      "additionalProperties": false,
      "description": "`fix/history.json` of the bundle of a fix loop.\n\nIt holds the diff hashes, the verdict of every oracle with its reasons, the limits and the\nbounds. It holds no prompt, no model reply, no credential, no timestamp and no host path.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/HistoryAttempt"
          },
          "title": "Attempts",
          "type": "array"
        },
        "final": {
          "$ref": "#/$defs/HistoryFinal"
        },
        "format": {
          "const": "assay-fix-history",
          "default": "assay-fix-history",
          "title": "Format",
          "type": "string"
        },
        "held_out_bounds": {
          "$ref": "#/$defs/HistoryBounds"
        },
        "limits": {
          "$ref": "#/$defs/HistoryLimits"
        },
        "loop_bounds": {
          "$ref": "#/$defs/HistoryBounds"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "vuln_class": {
          "title": "Vuln Class",
          "type": "string"
        }
      },
      "required": [
        "vuln_class",
        "limits",
        "loop_bounds",
        "held_out_bounds",
        "attempts",
        "final"
      ],
      "title": "FixHistory",
      "type": "object"
    },
    "HistoryAttempt": {
      "additionalProperties": false,
      "properties": {
        "diff_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diff Sha256"
        },
        "in_loop_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity_violation": {
          "default": false,
          "title": "Integrity Violation",
          "type": "boolean"
        },
        "number": {
          "title": "Number",
          "type": "integer"
        },
        "oracles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HistoryOracle"
          },
          "title": "Oracles",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "evaluated",
            "model_output_invalid"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "problems": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Reason"
          },
          "title": "Problems",
          "type": "array"
        }
      },
      "required": [
        "number",
        "outcome",
        "diff_sha256",
        "in_loop_verdict"
      ],
      "title": "HistoryAttempt",
      "type": "object"
    },
    "HistoryBounds": {
      "additionalProperties": false,
      "properties": {
        "fuzz_runs": {
          "title": "Fuzz Runs",
          "type": "integer"
        },
        "fuzz_seed": {
          "title": "Fuzz Seed",
          "type": "string"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "symbolic": {
          "title": "Symbolic",
          "type": "boolean"
        }
      },
      "required": [
        "profile",
        "fuzz_seed",
        "fuzz_runs",
        "symbolic"
      ],
      "title": "HistoryBounds",
      "type": "object"
    },
    "HistoryFinal": {
      "additionalProperties": false,
      "properties": {
        "attempts_used": {
          "title": "Attempts Used",
          "type": "integer"
        },
        "decision": {
          "enum": [
            "held_out_run",
            "last_attempt",
            "none"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decisive_attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decisive Attempt"
        },
        "diff_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diff Sha256"
        },
        "differs_from_in_loop": {
          "title": "Differs From In Loop",
          "type": "boolean"
        },
        "in_loop_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/FinalVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "statement": {
          "maxLength": 1000,
          "title": "Statement",
          "type": "string"
        },
        "stopped": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stopped"
        },
        "verdict": {
          "$ref": "#/$defs/FinalVerdict"
        }
      },
      "required": [
        "decision",
        "verdict",
        "in_loop_verdict",
        "differs_from_in_loop",
        "decisive_attempt",
        "diff_sha256",
        "reasons",
        "stopped",
        "attempts_used",
        "statement"
      ],
      "title": "HistoryFinal",
      "type": "object"
    },
    "HistoryLimits": {
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_changed_lines": {
          "title": "Max Changed Lines",
          "type": "integer"
        },
        "max_diff_bytes": {
