        },
        "runs": {
          "items": {
            "$ref": "#/$defs/RunBounds"
          },
          "title": "Runs",
          "type": "array"
        },
        "solver": {
          "title": "Solver",
          "type": "string"
        },
        "solver_timeout_s": {
          "title": "Solver Timeout S",
          "type": "integer"
        },
        "timeout_s": {
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "required": [
