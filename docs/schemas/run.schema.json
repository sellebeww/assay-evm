        "oracle",
        "status",
        "verdict",
        "reasons",
        "summary"
      ],
      "title": "OracleRow",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "description": "A structured reason: a stable code, a human-readable detail and an optional location.\n\n`detail` may quote untrusted text (file names, identifiers, revert reasons); it is data and\nmust be escaped before it is printed.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "maxLength": 500,
          "title": "Detail",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "Reason",
      "type": "object"
    },
    "RevisionKind": {
      "enum": [
        "vulnerable",
        "patched"
      ],
      "title": "RevisionKind",
      "type": "string"
    },
    "RunBounds": {
      "additionalProperties": false,
      "description": "One Halmos run; `problem` says how a run without a usable report ended.",
      "properties": {
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Problem"
