          "type": "integer"
        },
        "max_files": {
          "title": "Max Files",
          "type": "integer"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "title": "Scope",
          "type": "array"
        }
      },
      "required": [
        "max_attempts",
        "max_changed_lines",
        "max_files",
        "max_diff_bytes",
        "scope"
      ],
      "title": "HistoryLimits",
      "type": "object"
    },
