          "type": "number"
        },
        "what": {
          "enum": [
            "halmos",
            "confirmation"
          ],
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "what",
        "seconds"
      ],
      "title": "RunTime",
      "type": "object"
    },
