        "solver",
        "loop_bound",
        "solver_timeout_s",
        "timeout_s",
        "memory_mib",
        "max_calls_per_property",
        "runs",
        "checks",
        "confirmed_property",
        "confirmation_replays",
        "replays_reproduced",
        "equivalence"
      ],
      "title": "SymbolicBounds",
      "type": "object"
    },
